{
  "name": "dsh-agent-identity",
  "version": "0.1.0",
  "private": false,
  "description": "Named agent identities for DeepSeek Harness: pick one per session, inject its body into the system prompt ahead of project instructions, manage many identities, delegate as an identity.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent",
    "identity",
    "persona",
    "system-prompt"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/store.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/store.js",
    "test": "node test/store.test.mjs && node test/client.test.mjs && node test/render.test.mjs && node test/host.test.mjs",
    "test:real": "pwsh -NoProfile -File scripts/test-real.ps1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.2-rc.5"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
